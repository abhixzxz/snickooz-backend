              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"username\": \"johndoe\",\n  \"gender\": \"male\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"location\": \"New York\",\n  \"bio\": \"Software Developer\",\n  \"company\": \"Tech Corp\",\n  \"socialLinks\": {\n    \"twitter\": \"@johndoe\",\n    \"linkedin\": \"linkedin.com/in/johndoe\"\n  }\n}"
            }
          }
        },
